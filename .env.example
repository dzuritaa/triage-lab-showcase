# Copy to .env for local work. Never commit the real thing.
# Placeholders here are deliberately not key-shaped so the secret scanner
# doesn't flag this file.

# Anthropic API key. Set a spend cap on this key in the console —
# an independent backstop to the budget counter in the Worker (see PLAN.md §4).
ANTHROPIC_API_KEY=<your-key-here>

# --- Live-mode guardrails (Worker, phase 3) ---
LIVE_CALLS_PER_IP_PER_HOUR=5
LIVE_CALLS_PER_DAY_TOTAL=200
MAX_INPUT_CHARS=4000

# --- Local retrieval adapter (phase 2) ---
# The deployed demo uses a flat JSON index instead. See ADR-003.
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
