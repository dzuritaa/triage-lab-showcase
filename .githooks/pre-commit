#!/bin/sh
# Block commits that contain secrets.
#
# CI also scans, but that is detection, not prevention: once a key reaches
# history it must be rotated even if the commit is never pushed. This is the
# gate that actually saves you.
#
# Enable once per clone:  git config core.hooksPath .githooks

set -e

# Probe the daemon, not the binary. `command -v docker` was the original check
# and it tests the wrong thing: with Docker Desktop installed but not running,
# the CLI is on PATH, the check passes, and `docker run` then fails an opaque
# npipe connection error that `set -e` turns into a blocked commit. The hook
# documents itself as warning and deferring to CI when Docker is unavailable,
# and it did the opposite. `docker info` covers both cases in one check.
if ! docker info >/dev/null 2>&1; then
  echo "pre-commit: docker unavailable — secret scan SKIPPED (CI will still scan)" >&2
  exit 0
fi

REPO=$(pwd)
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    REPO=$(pwd -W)
    export MSYS_NO_PATHCONV=1
    ;;
esac

docker run --rm -v "$REPO:/repo" zricethezav/gitleaks:v8.28.0 \
  protect --staged --source=/repo --redact --verbose
